      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "_IY366MMk"
          },
          "editorMode": "code",
          "expr": "sum(increase(apm_repeated_query_affected_requests_total{instance!=\"\", project_name=~\"${project:regex}\", cluster_name=~\"${cluster:regex}\", normalized_service=\"django\", http_method=~\"${method:regex}\", http_route=\"${route:raw}\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
