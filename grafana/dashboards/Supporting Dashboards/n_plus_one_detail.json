      "id": 1,
      "options": {
        "content": "<section class=\"n1-page\">\n  <div class=\"n1-heading\"><div><span class=\"n1-eyebrow\">Django performance advisory</span><h1>Repeated Queries <span class=\"n1-badge\">Potential N+1</span></h1></div><span class=\"n1-priority\">Info</span></div>\n  <div class=\"n1-scope\"><span><b>Project</b> <em id=\"n1-project\">—</em></span><span><b>Cluster</b> <em id=\"n1-cluster\">—</em></span><span><b>Service</b> django</span><span><b>Endpoint</b> <em id=\"n1-method\">—</em> <em id=\"n1-route\">—</em></span></div>\n  <p class=\"n1-explainer\">Affected request totals and affected-request rate are queried live from Prometheus in the table below. Select one project, cluster, method, and route to investigate a single endpoint. A sampled trace below is an example affected request; it does not account for every request in the metric total.</p>\n  <p class=\"n1-empty-note\">If no trace appears, no matching sampled trace is available in this time range. The affected-request metric remains valid. Query shapes and timings appear only in retained traces.</p>\n</section>",
        "defaultContent": "<section class=\"n1-page\">\n  <div class=\"n1-heading\"><div><span class=\"n1-eyebrow\">Django performance advisory</span><h1>Repeated Queries <span class=\"n1-badge\">Potential N+1</span></h1></div><span class=\"n1-priority\">Info</span></div>\n  <div class=\"n1-scope\"><span><b>Project</b> <em id=\"n1-project\">—</em></span><span><b>Cluster</b> <em id=\"n1-cluster\">—</em></span><span><b>Service</b> django</span><span><b>Endpoint</b> <em id=\"n1-method\">—</em> <em id=\"n1-route\">—</em></span></div>\n  <p class=\"n1-explainer\">Affected request totals and affected-request rate are queried live from Prometheus in the table below. Select one project, cluster, method, and route to investigate a single endpoint. A sampled trace below is an example affected request; it does not account for every request in the metric total.</p>\n  <p class=\"n1-empty-note\">If no trace appears, no matching sampled trace is available in this time range. The affected-request metric remains valid. Query shapes and timings appear only in retained traces.</p>\n</section>",
        "editor": {
          "format": "auto",
          "language": "html"
        },
        "editors": [
          "content",
          "defaultContent",
          "afterRender",
          "styles"
        ],
        "afterRender": "const root = context.element;\nif (root) {\n  for (const [id, name] of [['n1-project', 'project'], ['n1-cluster', 'cluster'], ['n1-method', 'method'], ['n1-route', 'route']]) {\n    const node = root.querySelector('#' + id);\n    if (node) node.textContent = context.grafana.replaceVariables('${' + name + '}') || '—';\n  }\n}",
        "renderMode": "allRows",
        "styles": ".n1-page{font-family:Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:#e2e8f0;padding:12px 18px;background:#0f172a;border:1px solid #334155;border-radius:8px}.n1-heading{display:flex;justify-content:space-between;align-items:center;gap:16px}.n1-eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#94a3b8}.n1-heading h1{font-size:22px;margin:4px 0 12px;color:#f8fafc}.n1-badge,.n1-priority{display:inline-block;font-size:11px;font-weight:700;border-radius:5px;padding:4px 8px;background:#0c4a6e;color:#7dd3fc;vertical-align:middle}.n1-priority{background:#164e63}.n1-scope{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 10px}.n1-scope span{background:#1e293b;border:1px solid #334155;border-radius:5px;padding:6px 9px;font-size:12px}.n1-scope b{color:#94a3b8;margin-right:6px}.n1-scope em{font-style:normal;color:#f8fafc}.n1-explainer,.n1-empty-note{font-size:12px;line-height:1.5;margin:5px 0;color:#cbd5e1}.n1-empty-note{color:#94a3b8}",
        "wrap": true
      },
      "title": "Repeated Queries · Endpoint Context",
      "type": "marcusolsson-dynamictext-panel",
      "datasource": {
        "type": "prometheus",
        "uid": "_IY366MMk"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "_IY366MMk"
          },
          "editorMode": "code",
          "expr": "sum(increase(apm_repeated_query_affected_requests_total{project_name=~\"${project:regex}\", cluster_name=~\"${cluster:regex}\", normalized_service=\"django\", http_method=~\"${method:regex}\", http_route=\"${route:raw}\"}[$__range]))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "_IY366MMk"
      },
      "description": "One row per project, cluster, HTTP method, and normalized route. Affected requests are independent of trace sampling. Rate uses all SDK-observed requests for the same endpoint.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Affected Request Rate %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 2,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "_IY366MMk"
          },
          "editorMode": "code",
          "expr": "label_join((sum by (project_name, cluster_name, http_method, http_route) (increase(apm_repeated_query_affected_requests_total{instance!=\"\", project_name=~\"${project:regex}\", cluster_name=~\"${cluster:regex}\", normalized_service=\"django\", http_method=~\"${method:regex}\", http_route=\"${route:raw}\"}[$__range])) or on (project_name, cluster_name, http_method, http_route) (0 * sum by (project_name, cluster_name, http_method, http_route) (increase(calls_total{metric_source=\"tp_trace_sdk\", instance!=\"\", project_name=~\"${project:regex}\", cluster_name=~\"${cluster:regex}\", normalized_service=\"django\", http_method=~\"${method:regex}\", http_route=\"${route:raw}\", span_kind=\"SPAN_KIND_SERVER\"}[$__range])))), \"n_plus_one_operation\", \" \", \"project_name\", \"cluster_name\", \"http_method\", \"http_route\")",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "_IY366MMk"
          },
          "editorMode": "code",
          "expr": "label_join(100 * (sum by (project_name, cluster_name, http_method, http_route) (increase(apm_repeated_query_affected_requests_total{instance!=\"\", project_name=~\"${project:regex}\", cluster_name=~\"${cluster:regex}\", normalized_service=\"django\", http_method=~\"${method:regex}\", http_route=\"${route:raw}\"}[$__range])) or on (project_name, cluster_name, http_method, http_route) (0 * sum by (project_name, cluster_name, http_method, http_route) (increase(calls_total{metric_source=\"tp_trace_sdk\", instance!=\"\", project_name=~\"${project:regex}\", cluster_name=~\"${cluster:regex}\", normalized_service=\"django\", http_method=~\"${method:regex}\", http_route=\"${route:raw}\", span_kind=\"SPAN_KIND_SERVER\"}[$__range])))) / clamp_min(sum by (project_name, cluster_name, http_method, http_route) (increase(calls_total{metric_source=\"tp_trace_sdk\", instance!=\"\", project_name=~\"${project:regex}\", cluster_name=~\"${cluster:regex}\", normalized_service=\"django\", http_method=~\"${method:regex}\", http_route=\"${route:raw}\", span_kind=\"SPAN_KIND_SERVER\"}[$__range])), 1), \"n_plus_one_operation\", \" \", \"project_name\", \"cluster_name\", \"http_method\", \"http_route\")",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B",
          "legendFormat": "Affected Request Rate %"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "_IY366MMk"
          },
          "editorMode": "code",
          "expr": "label_join(sum by (project_name, cluster_name, http_method, http_route) (increase(calls_total{metric_source=\"tp_trace_sdk\", instance!=\"\", project_name=~\"${project:regex}\", cluster_name=~\"${cluster:regex}\", normalized_service=\"django\", http_method=~\"${method:regex}\", http_route=\"${route:raw}\", span_kind=\"SPAN_KIND_SERVER\"}[$__range])), \"n_plus_one_operation\", \" \", \"project_name\", \"cluster_name\", \"http_method\", \"http_route\")",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "C"
        }
      ],
      "title": "Endpoint Impact · Selected Time Range",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "n_plus_one_operation",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "n_plus_one_operation": true
            },
            "indexByName": {
              "project_name": 0,
              "cluster_name": 1,
              "http_method": 2,
              "http_route": 3,
              "Value #A": 4,
              "Value #C": 5,
              "Value #B": 6
            },
            "renameByName": {
              "project_name": "Project",
              "cluster_name": "Cluster",
              "http_method": "Method",
              "http_route": "Route",
              "Value #A": "Affected Requests",
              "Value #C": "Total Requests",
              "Value #B": "Affected Request Rate %"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Each row is an example sampled affected request, not the source of the aggregated metric. Candidate query/count/cumulative-time/average-time arrays share an index and are sorted by count, then cumulative time; at most five candidates are retained. Omitted candidate count and tracker overflow disclose incomplete evidence. Open the trace ID for the full waterfall. If this table is empty, no matching sampled trace is available in the selected range.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
