      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "limit": 20,
          "query": "{ resource.project_name =~ \"${project:regex}\" && resource.cluster_name =~ \"${cluster:regex}\" && span.repeated_query.detected = true && span.http.method =~ \"${method:regex}\" && span.http.route_template = \"${route:raw}\" } | select(span.n_plus_one.dominant_count, span.n_plus_one.dominant_duration_ms, span.n_plus_one.request_impact_pct, span.n_plus_one.dominant_query)",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "spans"
        }
      ],
      "title": "Duplicated SQL Query",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Duration": true,
              "Span ID": true,
              "Start time": true,
              "Trace ID": true,
              "Trace Name": true,
              "Trace Service": true,
              "cluster_name": true,
              "http.method": true,
              "http.route_template": true,
              "repeated_query.detected": true,
              "traceID": true,
              "project_name": true
            },
            "indexByName": {
              "n_plus_one.dominant_count": 0,
              "n_plus_one.dominant_duration_ms": 1,
              "n_plus_one.request_impact_pct": 2,
              "n_plus_one.dominant_query": 3
            },
            "renameByName": {
              "n_plus_one.dominant_count": "Executions",
              "n_plus_one.dominant_duration_ms": "DB Time (ms)",
              "n_plus_one.dominant_query": "Duplicated SQL Query",
              "n_plus_one.request_impact_pct": "Impact %"
            }
          }
        }
      ],
