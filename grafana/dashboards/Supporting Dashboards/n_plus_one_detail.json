{
  "annotations": {
    "list": []
  },
  "description": "Investigate repeated database query candidates for a Django endpoint. Prometheus reports affected request count and rate; sampled Tempo traces provide example query shapes and timing.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "arrow-left",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "\u2190 Back to Needs Attention",
      "type": "link",
      "url": "/d/tp-trace-needs-attention?${project:queryparam}&${cluster:queryparam}&${__url_time_range}"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "_IY366MMk"
      },
      "description": "Total server requests on this endpoint in the selected time range.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
