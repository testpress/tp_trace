        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 12,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "_IY366MMk"
          },
          "editorMode": "code",
          "expr": "100 * (sum(increase(apm_repeated_query_affected_requests_total{instance!=\"\", project_name=~\"${project:regex}\", cluster_name=~\"${cluster:regex}\", normalized_service=\"django\", http_method=~\"${method:regex}\", http_route=\"${route:raw}\"}[$__range])) or vector(0)) / clamp_min(sum(increase(calls_total{metric_source=\"tp_trace_sdk\", instance!=\"\", project_name=~\"${project:regex}\", cluster_name=~\"${cluster:regex}\", normalized_service=\"django\", http_method=~\"${method:regex}\", http_route=\"${route:raw}\", span_kind=\"SPAN_KIND_SERVER\"}[$__range])), 1)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Affected Rate",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Maximum number of times the duplicate query ran in a single request.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
