    {
      "datasource": {
        "type": "prometheus",
        "uid": "_IY366MMk"
      },
      "description": "Percentage of requests on this endpoint affected by repeated queries.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
