            "properties": [
              {
                "id": "displayName",
                "value": "Calls per shape (same order)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "span.repeated_query.candidate_duration_ms"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Cumulative ms per shape (same order)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
