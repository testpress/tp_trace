          "limit": 100,
          "query": "{ resource.project_name =~ \"${project:regex}\" && resource.cluster_name =~ \"${cluster:regex}\" && span.repeated_query.detected = true && span.http.method =~ \"${method:regex}\" && span.http.route_template = \"${route:raw}\" } | select(span.repeated_query.candidate_queries, span.repeated_query.candidate_counts, span.repeated_query.candidate_duration_ms, span.repeated_query.candidate_avg_duration_ms, span.repeated_query.omitted_candidate_count, span.n_plus_one.dominant_query, span.n_plus_one.dominant_count, span.n_plus_one.dominant_duration_ms, span.n_plus_one.dominant_avg_duration_ms, span.n_plus_one.request_impact_pct, span.n_plus_one.severity, span.n_plus_one.tracker_overflowed, span.db.query_count, span.http.request.duration_ms)",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "spans"
        }
      ],
      "title": "Example Affected Traces · Sampled Evidence",
      "type": "table"
    }
