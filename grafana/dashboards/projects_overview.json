{
  "annotations": {
    "list": []
  },
  "description": "tp_trace — Unified APM & Infrastructure root overview by project. Click a project to open its clusters, servers, and telemetry.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "Infra & Cluster Monitoring",
      "type": "link",
      "url": "/d/tp-trace-infra-monitoring"
    },
    {
      "asDropdown": false,
      "icon": "apps",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "Service Catalog",
      "type": "link",
      "url": "/d/tp-trace-project-catalog"
    },
    {
      "asDropdown": false,
      "icon": "heartbeat",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "Telemetry Pipeline",
      "type": "link",
      "url": "/d/tp-trace-otel-collector-health"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": true,
      "title": "Traces",
      "type": "link",
      "url": "/explore?left=%5B%22${__from}%22,%22${__to}%22,%22${DS_TEMPO}%22,%7B%7D%5D"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Click a project to open its Infra & Cluster Monitoring view (clusters, servers, CPU/memory/disk).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Project"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": false,
                    "title": "Open Infra & Cluster Monitoring",
                    "url": "/d/tp-trace-infra-monitoring?var-project=${__data.fields.Project:percentencode}&${__url_time_range}"
                  },
                  {
                    "targetBlank": false,
                    "title": "Open Service Catalog",
                    "url": "/d/tp-trace-project-catalog?var-project=${__data.fields.Project:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Services"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 360
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RPS"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P95 Latency"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Max Disk %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 75
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 10,
      "options": {
        "cellHeight": "md",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "group by (project_name, normalized_service) (apm_calls_total{project_name=~\"${project:regex}\",normalized_service!=\"pgbouncer\"})",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (project_name) (rate(apm_calls_total{project_name=~\"${project:regex}\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum by (project_name) (rate(apm_calls_total{project_name=~\"${project:regex}\",span_kind=\"SPAN_KIND_SERVER\",error=\"true\"}[$__rate_interval])) / clamp_min(sum by (project_name) (rate(apm_calls_total{project_name=~\"${project:regex}\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])), 1e-9)) * 100",
          "format": "table",
          "instant": true,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (project_name, le) (rate(apm_duration_milliseconds_bucket{project_name=~\"${project:regex}\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "format": "table",
          "instant": true,
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (project_name) (max by (host_ip) (label_replace(100 * (1 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\",mountpoint!~\"/mnt/disk.*\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\",mountpoint!~\"/mnt/disk.*\"})), \"host_ip\", \"$1\", \"instance\", \"([^:]+):9100\")) * on(host_ip) group_left(project_name) group by (project_name, host_ip) (label_replace(apm_calls_total{project_name=~\"${project:regex}\",span_kind=\"SPAN_KIND_SERVER\",instance!=\"\"}, \"host_ip\", \"$1\", \"instance\", \"(.+)\")))",
          "format": "table",
          "instant": true,
          "refId": "I"
        }
      ],
      "title": "Projects — APM & Infrastructure Summary",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "Value #D": {
                "aggregations": [
                  "firstNotNull"
                ],
                "operation": "aggregate"
              },
              "Value #E": {
                "aggregations": [
                  "firstNotNull"
                ],
                "operation": "aggregate"
              },
              "Value #F": {
                "aggregations": [
                  "firstNotNull"
                ],
                "operation": "aggregate"
              },
              "Value #I": {
                "aggregations": [
                  "firstNotNull"
                ],
                "operation": "aggregate"
              },
              "normalized_service": {
                "aggregations": [
                  "allValues"
                ],
                "operation": "aggregate"
              },
              "project_name": {
                "aggregations": [],
                "operation": "groupby"
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #C": true
            },
            "indexByName": {
              "project_name": 0,
              "normalized_service (allValues)": 1,
              "Value #D (firstNotNull)": 2,
              "Value #E (firstNotNull)": 3,
              "Value #F (firstNotNull)": 4,
              "Value #I (firstNotNull)": 5
            },
            "renameByName": {
              "Value #D (firstNotNull)": "RPS",
              "Value #E (firstNotNull)": "Error %",
              "Value #F (firstNotNull)": "P95 Latency",
              "Value #I (firstNotNull)": "Max Disk %",
              "normalized_service (allValues)": "Services",
              "project_name": "Project"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "tp_trace",
    "apm",
    "infra",
    "projects",
    "overview"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "Prometheus",
          "value": "_IY366MMk"
        },
        "hide": 2,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {
          "selected": true,
          "text": "Tempo",
          "value": "tempo"
        },
        "hide": 2,
        "includeAll": false,
        "label": "Tracing Datasource",
        "multi": false,
        "name": "DS_TEMPO",
        "options": [],
        "query": "tempo",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(apm_calls_total, project_name)",
        "hide": 0,
        "includeAll": true,
        "label": "Project",
        "multi": true,
        "name": "project",
        "options": [],
        "query": {
          "query": "label_values(apm_calls_total, project_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Projects Overview",
  "uid": "tp-trace-projects-overview",
  "version": 1
}
