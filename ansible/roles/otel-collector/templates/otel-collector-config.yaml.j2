# Managed by Ansible. Do not edit manually.
receivers:
  otlp:
    protocols:
      grpc:
        endpoint: {{ otel_collector_otlp_grpc_bind }}:{{ otel_collector_otlp_grpc_port }}
      http:
        endpoint: {{ otel_collector_otlp_http_bind }}:{{ otel_collector_otlp_http_port }}

  prometheus/internal:
    config:
      scrape_configs:
        - job_name: otel-collector
          scrape_interval: 15s
          static_configs:
            - targets: ["localhost:8888"]
              labels:
                source: "otelcol-telemetry"
                instance: "{{ otel_collector_instance }}"
                collector_alias: "{{ otel_collector_alias }}"

processors:
  memory_limiter:
    check_interval: 500ms
    limit_mib: {{ otel_collector_memory_limit_mib }}
    spike_limit_mib: {{ otel_collector_memory_spike_limit_mib }}

  resource/drop_ephemeral:
    attributes:
      - key: service.instance.id
        action: delete
      - key: process.pid
        action: delete
      - key: worker_id
        action: delete

  # Apply SDK metadata removal only to the span-metrics branch.
  # Preserve collector.instance.id to distinguish cumulative metric writers.
  resource/spanmetrics_drop_sdk:
    attributes:
      - key: telemetry.sdk.version
        action: delete
      - key: telemetry.sdk.language
        action: delete
      - key: telemetry.sdk.name
        action: delete

  # Exclude internal spans and Django SERVER spans from spanmetrics.
  # Django HTTP RED metrics are emitted natively by the SDK, while
  # dependencies (Postgres, Redis, Celery, requests) use spanmetrics.
  filter/spanmetrics_drop_non_dependencies:
    error_mode: ignore
    traces:
      span:
        # Invariant 1: INTERNAL spans must NEVER generate RED metrics
        - kind == SPAN_KIND_INTERNAL
        # Invariant 2: Django SERVER spans are skipped; metrics are emitted natively by SDK
        # Primary classification: normalized.service == "django"
        # Migration fallback: django.route attribute for legacy tp_trace SDK spans
        - kind == SPAN_KIND_SERVER and (attributes["normalized.service"] == "django" or attributes["django.route"] != nil)

  transform/spanmetrics_route:
    error_mode: ignore
    trace_statements:
      - context: span
        statements:
          - set(attributes["http.route"], attributes["http.route_template"]) where attributes["http.route_template"] != nil
          - set(attributes["http.route"], attributes["django.route"]) where attributes["http.route_template"] == nil and attributes["django.route"] != nil
          - set(attributes["http.route"], "__unmatched__") where attributes["http.route_template"] == nil and attributes["django.route"] == nil and attributes["http.route"] != nil

  transform/spanmetrics_sanitize:
    error_mode: ignore
    trace_statements:
      - context: span
        statements:
          - delete_key(attributes, "http.route") where attributes["db.system"] != nil
          - delete_key(attributes, "http.method") where attributes["db.system"] != nil
          - set(attributes["normalized.operation"], attributes["db.query.summary"]) where attributes["normalized.operation"] == nil and attributes["db.query.summary"] != nil and attributes["db.system"] != nil
          - set(attributes["normalized.operation"], attributes["db.operation"]) where attributes["normalized.operation"] == nil and attributes["db.operation"] != nil

  batch:
    timeout: {{ otel_collector_batch_timeout }}
    send_batch_size: {{ otel_collector_batch_send_size }}
    send_batch_max_size: {{ otel_collector_batch_max_size }}

connectors:
  spanmetrics:
    metrics_flush_interval: {{ otel_collector_spanmetrics_flush_interval }}
{% if otel_collector_spanmetrics_namespace is defined and otel_collector_spanmetrics_namespace | length > 0 %}
    namespace: {{ otel_collector_spanmetrics_namespace }}
{% endif %}
    histogram:
      unit: ms
      explicit:
        buckets:
          - 5ms
          - 25ms
          - 100ms
          - 250ms
          - 500ms
          - 1s
          - 2.5s
          - 5s
    dimensions:
      - name: http.method
        default: ""
      - name: http.status_code
        default: ""
      - name: http.route
        default: ""
      - name: db.system
        default: ""
      - name: db.operation
        default: ""
      - name: db.instance
        default: ""
      - name: error
        default: ""
      - name: normalized.service
        default: ""
      - name: normalized.operation
        default: ""
      - name: institute.subdomain
        default: ""
    exclude_dimensions:
      - span.name
    metrics_expiration: {{ otel_collector_spanmetrics_metrics_expiration }}
    series_expiration: {{ otel_collector_spanmetrics_series_expiration }}
    # Limit applies per resource aggregation, not to total Prometheus series.
    aggregation_cardinality_limit: {{ otel_collector_spanmetrics_aggregation_cardinality_limit }}

exporters:
  otlp/tempo:
    endpoint: {{ otel_collector_tempo_endpoint }}
    tls:
      insecure: {{ "true" if otel_collector_tempo_tls_insecure else "false" }}
    timeout: 10s
{% if otel_collector_tempo_retry_enabled %}
    retry_on_failure:
      enabled: true
      initial_interval: {{ otel_collector_tempo_retry_initial_interval }}
      max_interval: {{ otel_collector_tempo_retry_max_interval }}
      max_elapsed_time: {{ otel_collector_tempo_retry_max_elapsed_time }}
{% endif %}
    sending_queue:
      enabled: true
      num_consumers: {{ otel_collector_tempo_queue_num_consumers }}
      queue_size: {{ otel_collector_tempo_queue_size }}

  prometheusremotewrite:
    endpoint: {{ otel_collector_prometheus_remote_write_endpoint }}
    timeout: 30s
    resource_to_telemetry_conversion:
      enabled: true
    external_labels:
      job: "otel-collector-spanmetrics"
      instance: "{{ otel_collector_instance }}"
      collector_alias: "{{ otel_collector_alias }}"

  prometheusremotewrite/internal:
    endpoint: {{ otel_collector_prometheus_remote_write_endpoint }}
    timeout: 30s
    resource_to_telemetry_conversion:
      enabled: true
    external_labels:
      job: "otel-collector"
      instance: "{{ otel_collector_instance }}"
      collector_alias: "{{ otel_collector_alias }}"

service:
  pipelines:
    traces:
      receivers:
        - otlp
      processors:
        - memory_limiter
        - resource/drop_ephemeral
        - batch
      exporters:
        - otlp/tempo

    traces/spanmetrics:
      receivers:
        - otlp
      processors:
        - memory_limiter
        - resource/drop_ephemeral
        - resource/spanmetrics_drop_sdk
        - filter/spanmetrics_drop_non_dependencies
        - transform/spanmetrics_route
        - transform/spanmetrics_sanitize
        - batch
      exporters:
        - spanmetrics

    metrics:
      receivers:
        - otlp
        - spanmetrics
      processors:
        - memory_limiter
        - resource/drop_ephemeral
        - batch
      exporters:
        - prometheusremotewrite

    metrics/internal:
      receivers:
        - prometheus/internal
      processors:
        - batch
      exporters:
        - prometheusremotewrite/internal

  telemetry:
    logs:
      level: {{ otel_collector_log_level }}
    metrics:
      readers:
        - pull:
            exporter:
              prometheus:
                host: {{ otel_collector_internal_metrics_bind }}
                port: {{ otel_collector_internal_metrics_port }}
                without_type_suffix: false
                without_units: false

