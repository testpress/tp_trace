# Environment for an application running directly on this machine.
# Give each application its own service/project name.
TP_TRACE_PROJECT_NAME=my-local-app
TP_TRACE_ENVIRONMENT=development
TP_TRACE_ENDPOINT=http://localhost:4318

# Equivalent settings for other OpenTelemetry SDKs using OTLP HTTP/protobuf.
OTEL_SERVICE_NAME=my-local-app
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# In another Docker Compose project, use http://host.docker.internal:4318
# on Docker Desktop/OrbStack, or join tp-dev-net and use http://collector:4318.
# For gRPC exporters: endpoint http://localhost:4317 with insecure TLS enabled.
